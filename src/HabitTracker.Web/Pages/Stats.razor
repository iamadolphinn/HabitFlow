@page "/stats"
@attribute [Authorize]
@implements IDisposable
@inject IHabitService Habits
@inject IHabitEvents Events
@inject CurrentUser User
@inject IJSRuntime JS

<PageTitle>Stats</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="mb-0">Your progress</h2>
    <button class="btn btn-outline-primary" @onclick="ExportCsv" disabled="@(_overview is null || _overview.TotalCheckIns == 0)">⬇ Export CSV</button>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger py-2">@_error</div>
}

@if (_overview is null)
{
    <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
}
else if (_overview.HabitCount == 0)
{
    <div class="alert alert-info">Create a habit first, then your stats will appear here.</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><div class="card text-center"><div class="card-body"><div class="fs-3 fw-bold">@_overview.HabitCount</div><div class="small text-muted">Active habits</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card text-center"><div class="card-body"><div class="fs-3 fw-bold">@_overview.DoneToday / @_overview.ScheduledToday</div><div class="small text-muted">Done today</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card text-center"><div class="card-body"><div class="fs-3 fw-bold">🔥 @_overview.BestStreak</div><div class="small text-muted">Best current streak</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card text-center"><div class="card-body"><div class="fs-3 fw-bold">@_overview.TotalCheckIns</div><div class="small text-muted">Total check-ins</div></div></div></div>
    </div>

    <h5>Last 7 days (completion)</h5>
    <div class="card mb-4"><div class="card-body">
        <BarChart Items="WeekItems" />
    </div></div>

    <h5>Last 12 weeks</h5>
    <div class="card mb-4"><div class="card-body overflow-auto">
        <Heatmap Cells="HeatCells" />
        <div class="form-text mt-2">Darker = a larger share of that day's habits completed.</div>
    </div></div>

    <h5>Badges</h5>
    <BadgeList Badges="_overview.Badges" />
}

@code {
    private Overview? _overview;
    private string? _error;
    private string _userId = "";

    private IEnumerable<BarChart.ChartItem> WeekItems => _overview!.Days
        .TakeLast(7)
        .Select(d => new BarChart.ChartItem(d.Date.ToString("ddd d"),
            d.Scheduled == 0 ? 0 : Math.Round(d.Completed * 100.0 / d.Scheduled, 0)));

    private IReadOnlyList<Heatmap.HeatCell> HeatCells => _overview!.Days.Select(d =>
    {
        var ratio = d.Scheduled == 0 ? 0 : (double)d.Completed / d.Scheduled;
        var level = ratio == 0 ? 0 : ratio <= 0.33 ? 1 : ratio <= 0.66 ? 2 : ratio < 1 ? 3 : 4;
        return new Heatmap.HeatCell(d.Date, level, $"{d.Date:ddd d MMM}: {d.Completed}/{d.Scheduled}");
    }).ToList();

    protected override async Task OnInitializedAsync()
    {
        _userId = (await User.GetAsync()).Id;
        Events.HabitsChanged += OnRemoteChange;
        await Load();
    }

    private async Task Load()
    {
        try { _overview = await Habits.GetOverviewAsync(_userId); }
        catch (Exception) { _error = "Could not load your stats."; }
    }

    private async Task ExportCsv()
    {
        try
        {
            var csv = await Habits.ExportCsvAsync(_userId);
            await JS.InvokeVoidAsync("habitInterop.downloadFile", "habits.csv", csv);
        }
        catch (Exception) { _error = "Export failed. Please try again."; }
    }

    private void OnRemoteChange(string userId)
    {
        if (userId != _userId) return;
        _ = InvokeAsync(async () => { await Load(); StateHasChanged(); });
    }

    public void Dispose() => Events.HabitsChanged -= OnRemoteChange;
}
